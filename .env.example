# Environment variables for NourishNet
# ========================================
# Get a Gemini API key at: https://ai.google.dev
# Get Telegram tokens at: https://core.telegram.org/bots
# The DATABASE_URL and PUBLIC_BASE_URL should match your deployment.

GEMINI_API_KEY="your-gemini-api-key-here"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
TELEGRAM_CHAT_ID="your-telegram-chat-id-here"
DATABASE_URL="sqlite+aiosqlite:///./dev.db"
PUBLIC_BASE_URL="http://localhost:5173"
STORE_IMAGES=true
STORAGE_BUCKET="food-images"
# Use a Supabase service role key for server-side bucket uploads.
SUPABASE_SERVICE_ROLE_KEY=""
VISION_MODEL="gemini-3.6-flash"